# Database Configuration
DATABASE_URL=sqlite:///./collabfoundry.db

# Gemini AI API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model ids — env-driven so they can be swapped without a code deploy
# (Google deprecates them; gemini-2.5-* is now paid/existing-users-only).
# gemini-flash-latest is the current free-tier working default.
GEMINI_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=3072

# JWT Secret Key — generate with: openssl rand -base64 32
SECRET_KEY=replace-with-output-of-openssl-rand-base64-32

# JWT Algorithm
ALGORITHM=HS256

# Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
